

<%- include("./partials/head.ejs") %>
<body>

<section id="nav">
  <%- include("./partials/nav.ejs")%>
</section>

<main>
    <!-- <%- include("./partials/dato.ejs")%> -->

    <div class="admin-innhold">
      <div class="venstre-innhold">
        <%- include("./partials/nav-side.ejs")%>


      </div>
      <div class="høyre-innhold">
        <div class="head-svar">
          <h1 class="overskrift-admin">Trekning</h1>
        </div>
       <div class="svar-per-luke-boks">
  <h2 class="luke-mini-overskrift">Luke</h2>

  <form method="get" action="/trekning">
    <select class="svar-boks" name="luke" onchange="this.form.submit()">
      <% for (let i = 1; i <= 24; i++) { %>
        <option value="<%= i %>" <%= luke === i ? "selected" : "" %>>
          Luke <%= i %><%= drawn.includes(i) ? " ✓" : "" %>
        </option>
      <% } %>
    </select>
  </form>

  <div class="resultat">
    <% if (winner) { %>
      <p>Vinner:</p>
      <h2><%= winner.user?.name || "Ukjent navn" %></h2>
      <p><%= winner.user?.email %></p>
      <p>Svar: <%= winner.answer?.answer %></p>
      <p class="dato-innhold">
        Trukket <%= new Date(winner.createdAt).toLocaleString("nb-NO", { timeZone: "Europe/Oslo", dateStyle: "short", timeStyle: "short" }) %>
      </p>
    <% } else if (eligible === 0) { %>
      <p>Ingen riktige svar på denne luken ennå.</p>
    <% } else { %>
      <p><%= eligible %> deltaker<%= eligible === 1 ? "" : "e" %> med riktig svar.</p>
      <form method="post" action="/trekning/<%= luke %>">
        <button class="grønn-knapp" id="lagre">Trekk vinner</button>
      </form>
    <% } %>
  </div>
</div>
          
          
       
        

        </div>
      </div>
    </div>
</main>




</body>
</html>
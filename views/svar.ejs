
<%- include("./partials/head.ejs") %>
<body>

<section id="nav">
  <%- include("./partials/nav.ejs")%>
</section>

<main>
    <!-- <%- include("./partials/dato.ejs")%> -->

    <div class="admin-innhold">
      <div class="venstre-innhold">
        <%- include("./partials/nav-side.ejs")%>


      </div>
      <div class="høyre-innhold">
        <div class="head-svar">
          <h1 class="overskrift-admin">Svar</h1>
        </div>
        <div class="svar-per-luke-boks">
           <form class="filtre" method="get" action="/svar">
    <input class="svar-boks" type="text" name="q" placeholder="Søk navn, e-post eller svar..."
           value="<%= filters.q %>">

    <select class="svar-boks" name="luke" onchange="this.form.submit()">
      <option value="">Alle luker</option>
      <% openLukes.forEach(n => { %>
        <option value="<%= n %>" <%= filters.luke === n ? "selected" : "" %>>Luke <%= n %></option>
      <% }) %>
    </select>

    <select class="svar-boks" name="status" onchange="this.form.submit()">
      <option value="">Alle statuser</option>
      <option value="riktig"       <%= filters.status === "riktig" ? "selected" : "" %>>Riktig</option>
      <option value="galt"         <%= filters.status === "galt" ? "selected" : "" %>>Galt</option>
      <option value="ikke-vurdert" <%= filters.status === "ikke-vurdert" ? "selected" : "" %>>Ikke vurdert</option>
    </select>

    <select class="svar-boks" name="sort" onchange="this.form.submit()">
      <option value="nyest"  <%= filters.sort === "nyest" ? "selected" : "" %>>Nyeste først</option>
      <option value="eldst"  <%= filters.sort === "eldst" ? "selected" : "" %>>Eldste først</option>
      <option value="riktig" <%= filters.sort === "riktig" ? "selected" : "" %>>Riktige først</option>
      <option value="galt"   <%= filters.sort === "galt" ? "selected" : "" %>>Gale først</option>
      <option value="ikke"   <%= filters.sort === "ikke" ? "selected" : "" %>>Ikke vurdert først</option>
      <option value="luke"   <%= filters.sort === "luke" ? "selected" : "" %>>Etter luke</option>
    </select>
  </form>

          <table>
    <thead>
      <tr>
        <th>LUKE</th>
        <th>NAVN</th>
        <th>E-POST</th>
        <th>SVAR</th>
        <th>FASIT</th>
        <th>DATO</th>
        <th>STATUS</th>
        <th>VURDER</th>
      </tr>
    </thead>
    <tbody>
      <% if (rows.length === 0) { %>
        <tr><td colspan="8">Ingen svar funnet.</td></tr>
      <% } %>
      <% rows.forEach(r => { %>
        <tr>
          <td><%= r.luke %></td>
          <td><%= r.user?.name || "–" %></td>
          <td><%= r.user?.email || "slettet bruker" %></td>
          <td><%= r.answer %></td>
          <td><%= r.fasit %></td>
          <td><%= new Date(r.createdAt).toLocaleString("nb-NO", { timeZone: "Europe/Oslo", dateStyle: "short", timeStyle: "short" }) %></td>
          <td>
            <span class="status status-<%= r.status %>">
              <%= r.status === "riktig" ? "Riktig" : r.status === "galt" ? "Galt" : "Ikke vurdert" %>
            </span>
          </td>
          <td class="vurder-celle">
            <form method="post" action="/svar/<%= r._id %>/vurder">
              <button class="vurder-knapp ok"  name="verdict" value="riktig" title="Riktig">✓</button>
              <button class="vurder-knapp bad" name="verdict" value="galt"   title="Galt">✗</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>



</main>




</body>
</html>
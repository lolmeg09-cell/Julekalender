
<%- include("./partials/head.ejs") %>
<body>

<section id="nav">
  <%- include("./partials/nav.ejs")%>
</section>

<div class="snow-zone">
 
  <main>
    <!-- <%- include("./partials/dato.ejs")%> -->

    
    
  <section class="hero">
    <div class="wrap" id="info_main">
      
      <div>
        <p class="info" id="dag"><%= today > 0 ? "I DAG, " + today + ". DESEMBER" : "KALENDEREN ÅPNER 1. DESEMBER" %></p>
        <h1 class="info" id="luke-info">Luke <%= today > 0 ? today : "" %></h1>
        <p class="info" id="åpnet"><%= opened %> av 24 luker er åpnet.</p>
      </div>
      
      <div class="btn-right">
       <% if (today > 0 && !doneLukes.includes(today)) { %>
          <a class="gul_knapp" href="/luke/<%= today %>">Åpne dagens luke</a>
        <% } %>
      </div>
      
    </div>
  </section>
  
  <div class="dekorasjon_line">
    <div class="line">
    </div>
    
    <div class="star">
      ✦
    </div>
    
    <div class="line">
    </div>
  </div>
  
  <div class="overskrift">
    <h1 id="alle-luker-txt">Alle luker</h1>
  </div>
  
  <div>
  <ul class="grid">
  <% for (let i = 1; i <= 24; i++) { %>
    <% if (doneLukes.includes(i)) { %>
      <li><span class="tile done" aria-label="Luke <%= i %> er åpnet"><b><%= i %></b><small>Åpnet ✓</small></span></li>
    <% } else if (i === today) { %>
      <li><a class="tile today" href="/luke/<%= i %>"><b><%= i %></b><small>I dag</small></a></li>
    <% } else if (i < today) { %>
      <li><a class="tile open" data-status="missed" data-luke="<%= i %>" href="/luke/<%= i %>"><b><%= i %></b></a></li>
    <% } else { %>
      <li><span data-status="lock" data-luke="<%= i %>" tabindex="0" role="button" class="tile lock"><b><%= i %></b></span></li>
    <% } %>
  <% } %>
</ul>
  </div>
  
  
  
</main>
</div>
<section class="popup-wrap">
  <div class="popup" id="popup">
    <div class="overlay"></div>
    <div class="popup-content">
      <h2>Denne luken kan ikke  åpnes</h2>
      <button class="lukk-btn">Lukk</button>
    </div>
  </div>
</section>


<section>
  <%- include("./partials/footer.ejs")%>
</section>

</body>
</html>
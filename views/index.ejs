
<%- include("./partials/head.ejs") %>
<body>

<section id="nav">
  <%- include("./partials/nav.ejs")%>
</section>

<div class="snow-zone">
 
  <main>
    <%- include("./partials/dato.ejs")%>

    
    
  <section class="hero">
    <div class="wrap" id="info_main">
      
      <div>
        <p class="info" id="dag">I DAG, 3. DESEMBER</p>
        <h1 class="info" id="luke-info">Luke </h1>
        <p class="info" id="åpnet">x av x luker er åpnet. Neste luke åpner i morgen</p>
      </div>
      
      <div class="btn-right">
        <button class="gul_knapp">Åpne dagens luke</button>
      </div>
      
    </div>
  </section>
  
  <div class="dekorasjon_line">
    <div class="line">
    </div>
    
    <div class="star">
      ✦
    </div>
    
    <div class="line">
    </div>
  </div>
  
  <div class="overskrift">
    <h1 id="alle-luker-txt">Alle luker</h1>
  </div>
  
  <div>
    <ul class="grid">
        <% for (let i = 1; i <= 24; i++) { %>
        <% if (i === today) { %>
          <li><a class="tile today" href="/luke/<%= i %>"><b><%= i %></b><small>I dag</small></a></li>
        <% } else if (i < today) { %>
          <li><a class="tile open" href="/luke/<%= i %>"><b><%= i %></b></a></li>
        <% } else { %>
          <li><span class="tile lock"><b><%= i %></b></span></li>
        <% } %>
      <% } %>
    </ul>
  </div>
  
  
  
</main>
</div>


<section>
  <%- include("./partials/footer.ejs")%>
</section>

</body>
</html>
<main>
    <%- include("./partials/dato.ejs")%>

    <div class="admin-innhold">
      <div class="venstre-innhold">
        <%- include("./partials/nav-side.ejs")%>


      </div>
      
      

      <div class="høyre-innhold">
        <div class="head-admin">
        <h1 class="overskrift-admin">Oversikt</h1>
      </div>
        
        <div class="mini-info-bokser">
          <div class="boks">
            <b><%= total %></b>
            <p>Svar totalt</p>
          </div>
          <div class="boks">
            <b><%= pending %></b>
            <p>Venter vurdering</p>
          </div>
          <div class="boks">
            <b><%= correct %></b>
            <p>Riktige svar</p>
          </div>
          <div class="boks">
            <b><%= participants %></b>
            <p>Deltakere</p>
          </div>
          <div class="boks">
            <b>0</b>
            <p>Luker med vinner</p>
          </div>

        </div>
        <div class="svar-per-luke-boks">
      
          <h2 class="overskrift-admin">Svar per luke</h2>
         
      <div class="søyle-diagram">
        <% counts.forEach((n, i) => { %>
          <div data-height="<%= Math.round((n / max) * 100) %>" title="Luke <%= i + 1 %>: <%= n %>"></div>
        <% }) %>
      </div>
      <script>
        document.querySelectorAll(".søyle-diagram > div[data-height]").forEach((bar) => {
          bar.style.height = `${bar.dataset.height}%`;
        });
      </script>
         

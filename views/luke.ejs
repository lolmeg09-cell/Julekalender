
<%- include("./partials/head.ejs") %>
<body>

<section id="nav">
  <%- include("./partials/nav.ejs")%>
</section>

<main class="luke-side">
    <article class="luke-kort">
    <h1>Luke <%= luke %></h1>
    <h2><%= question.question %></h2>

    <% if (embedUrl) { %>
      <div class="luke-video">

        <iframe width="560" height="315" src="<%= embedUrl %>"
          title="Video til luke <%= luke %>" allowfullscreen
          style="max-width:100%"></iframe>
        </div>
    <% } %>

       <form action="/luke/<%= luke %>" method="post" class="luke-skjema">
      <% if (question.type === "multiple_choice") { %>
        <fieldset class="luke-valg">
          <legend class="sr-only">Velg et svar</legend>
          <% question.options.forEach(opt => { %>
            <label class="valg">
              <input  type="radio" name="answer" value="<%= opt %>" required>
              <%= opt %>
            </label><br>
          <% }) %>
        </fieldset>
      <% } else { %>
        <label class="luke-label" for="answer">Ditt svar</label>
        <input class="svar-boks" type="text" name="answer" id="answer" placeholder="Skriv svaret ditt her" autocomplete="off" required>
      <% } %>

            <button class="gul_knapp luke-send" type="submit">Send svar</button>
            </form>

            <a class="luke-tilbake"  href="/">Tilbake til Kalenderen</a>
</article>
</main>

</body>
</html>
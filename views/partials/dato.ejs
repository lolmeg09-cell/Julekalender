<div id="dato" class="wrap">
  <form id="dato-wrap" method="get" action="<%= path %>">
    <label for="sel" class="dato-innhold" style="margin:0;font-weight:400">Dato:</label>
    <select id="sel" name="luke" class="dato-innhold" onchange="this.form.submit()">
      <% for (let i = 1; i <= 24; i++) { %>
        <option value="<%= i %>" <%= (typeof luke !== "undefined" && luke === i) ? "selected" : "" %>>
          <%= i %>. desember
        </option>
      <% } %>
    </select>
  </form>
</div>